# Cloudflare Pages reads this from the build output root.
# Files in public/ are copied to dist/ verbatim, so this ships as dist/_headers.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Vite fingerprints everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the HTML entry point — it's what points at the hashed assets.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Not hashed, and read before first paint — keep it fresh but allow a short cache.
/theme-init.js
  Cache-Control: public, max-age=300
